<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="fill_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView android:layout_width="wrap_content" android:layout_height="wrap_content">
        <RelativeLayout android:layout_width="fill_parent" android:layout_height="fill_parent">
            <LinearLayout android:orientation="vertical" android:padding="15.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <TextView android:textColor="?colorAccent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="URL/Host" />
                <EditText android:id="@id/url_host" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="10.0dip" android:hint="www.google.com" android:ems="10" android:inputType="textUri" />
                <RadioGroup android:orientation="horizontal" android:id="@id/split_group" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="10.0dip" android:weightSum="3.0">
                    <RadioButton android:id="@id/split_normal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal" android:layout_weight="1.0" />
                    <RadioButton android:id="@id/split_delay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delay Split" android:layout_weight="1.0" />
                    <RadioButton android:id="@id/split_none" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="None" android:layout_weight="1.0" />
                </RadioGroup>
                <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="10.0dip" android:weightSum="2.0">
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0">
                        <TextView android:textColor="?colorAccent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Request Method" />
                        <Spinner android:id="@id/request_method" android:layout_width="fill_parent" android:layout_height="40.0dip" />
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_alignParentRight="true">
                        <TextView android:textColor="?colorAccent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Injection Method" />
                        <Spinner android:id="@id/inject_method" android:layout_width="fill_parent" android:layout_height="40.0dip" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:textColor="?colorAccent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Query Mode" />
                <RadioGroup android:orientation="horizontal" android:id="@id/query_mode" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="10.0dip">
                    <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal" android:layout_weight="1.0" />
                    <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Front" android:layout_weight="1.0" />
                    <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back" android:layout_weight="1.0" />
                </RadioGroup>
                <TextView android:textColor="?colorAccent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Extra Headers" />
                <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="10.0dip" android:weightSum="2.0">
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0">
                        <CheckBox android:id="@id/online_host" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Online-Host" />
                        <CheckBox android:id="@id/reverse_proxy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reverse-Proxy" />
                        <CheckBox android:id="@id/dual_connect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dual-Connect" />
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0">
                        <CheckBox android:id="@id/forward_host" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Forward-Host" />
                        <CheckBox android:id="@id/keep_alive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keep-Alive" />
                        <CheckBox android:id="@id/full_host" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full-Host" />
                    </LinearLayout>
                </LinearLayout>
                <Button android:textColor="#ffffffff" android:id="@id/generate_payload" android:background="?colorPrimary" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="GENERATE" />
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>